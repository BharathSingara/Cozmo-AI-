# Optional: enables multimodal book/nonbook detection through Gemini (frames leave this machine).
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
# Local-only default: no image sent to a model vendor.
ALLOW_REMOTE_VISION=false
# If true, enables external catalog and price API requests; use only with consent.
ALLOW_EXTERNAL_LOOKUPS=false
# Optional regional physical-goods listings (preferred, especially India)
SERPAPI_KEY=
# Optional alternative for eBay supported regions: an OAuth Browse access token
EBAY_BROWSE_TOKEN=
# Protect this local prototype with a key in shared environments (recommended).
APP_ACCESS_KEY=
DATA_ROOT=./data/sessions
MAX_FRAMES_PER_SESSION=200
PRICE_TIMEOUT_SECONDS=6

# Configurable per-currency appraisal thresholds (local units, not item prices).
APPRAISAL_THRESHOLD_INR=80000
APPRAISAL_THRESHOLD_USD=1000
APPRAISAL_THRESHOLD_GBP=800
APPRAISAL_THRESHOLD_EUR=900
APPRAISAL_THRESHOLD_CAD=1400
APPRAISAL_THRESHOLD_AUD=1600
